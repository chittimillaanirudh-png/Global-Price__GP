# Server Port (Render will automatically assign PORT in production)
PORT=5000

# Gemini API Key (MUST BE KEPT SECRET ON BACKEND ONLY)
GEMINI_API_KEY=your_gemini_api_key_here

# Deployed Frontend Origin (used for CORS configuration)
# Production URL: https://global-price-gp.vercel.app
FRONTEND_URL=https://global-price-gp.vercel.app
